# Niblr — single-store build. Copy to .env.local and fill in the two required values.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/niblr
PAYLOAD_SECRET=change-me-to-a-long-random-string

# The host your store is served on, without protocol. Local dev uses lvh.me
# (resolves to 127.0.0.1). Production: your domain, e.g. shop.example.com
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# Media storage (S3-compatible). Leave unset to store uploads on local disk in dev.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Transactional email (order confirmations, magic links). Optional in dev.
# RESEND_API_KEY=

# Payment gateways are configured in the admin (Settings → Payments), not here.
